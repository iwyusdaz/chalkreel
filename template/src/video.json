    {
      "id": "seg-04",
      "title": "Why it works",
      "sceneKind": "cycle",
      "startSec": 57.2,
      "durationSec": 19.8,
      "narration": "Why does struggling to recall help? Each time you pull a memory out, your brain rebuilds the path to it, and the path gets easier to find next time. Psychologists call this a desirable difficulty. The effort is not a sign of failure, it is part of how the memory gets stronger.",
      "visual": {
        "backdrop": "chalkboard",
        "description": "A three-step chalk cycle diagram: 'Try to recall', 'Rebuild the path', 'Easier next time', with arrows looping between them. Caption: 'Desirable difficulty'.",
        "elements": [
          {
            "type": "cycle",
            "steps": [
              "Try to recall",
              "Rebuild the path",
              "Easier next time"
            ]
          },
          {
            "type": "caption",
            "text": "Desirable difficulty"
          }
        ],
        "onScreenText": [
