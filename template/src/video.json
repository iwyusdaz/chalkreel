    {
      "id": "seg-02",
      "title": "What retrieval practice is",
      "sceneKind": "definition",
      "startSec": 18.2,
      "durationSec": 17.6,
      "narration": "Retrieval practice means pulling information out of your memory instead of putting it in again. Rereading feels productive because the page looks familiar. But familiarity is not the same as being able to recall it later, without the book.",
      "visual": {
        "backdrop": "chalkboard",
        "description": "Two chalk arrows: one labeled 'IN: reread' pointing at a head outline, one labeled 'OUT: recall' pointing away from it. The OUT arrow is drawn thicker.",
        "elements": [
          {
            "type": "definition",
            "term": "Retrieval practice",
            "definition": "Pull information OUT of memory"
          },
          {
            "type": "arrow-in-out",
            "inLabel": "IN: reread",
            "outLabel": "OUT: recall"
          }
        ],
        "onScreenText": [
          "Retrieval practice: pull information OUT of memory",
          "Familiarity is not recall"
        ]
      },
